    [`std::partial_ordering`], [`less`], [Меньше], [`2.0 <=> 4.5` $arrow$ `less`],
    [`std::partial_ordering`], [`greater`], [Больше], [`9.81 <=> 3.0` $arrow$ `greater`],
    [`std::partial_ordering`], [`unordered`], [Не поддаются сравнению], [`NaN <=> 1.0` $arrow$ `unordered`],
)

=== Поведение по умолчанию

- Порядок: сначала сравниваются базовые классы (в порядке перечисления в объявлении), затем поля в порядке объявления.

=== Примеры интерпретации выражений

```cpp
a < b
```
преобразуется в:
```cpp
(a <=> b) < 0
```

```cpp
a < 2;  // → (a <=> 2) < 0
a == 2; // → (a <=> 2) == 0
a >= 2; // → (a <=> 2) >= 0
```

=== Способы определения

==== С помощью `= default`

```cpp
#include <compare> // нужно для типов результата: strong_ordering и др.

class Point
{
    int x, y;
  public:
    // членам и базам тоже нужен ==
    bool operator==(const Point&) const = default;
    // вернёт std::strong_ordering
    auto operator<=>(const Point&) const = default;
};


class P
{
    int i;
    double d;
  public:
    bool operator==(const P&) const = default;
    // partial_ordering из-за double
    auto operator<=>(const P&) const = default;
};
```

==== Вручную

```cpp
#include <compare>

struct Pair
{
    int x, y;

    bool operator==(const Pair& r) const noexcept
    {
        return x == r.x && y == r.y;
    }

    std::strong_ordering operator<=>(const Pair& r) const noexcept
    {
        if (x < r.x) return std::strong_ordering::less;
        if (x > r.x) return std::strong_ordering::greater;
        if (y < r.y) return std::strong_ordering::less;
        if (y > r.y) return std::strong_ordering::greater;
        return std::strong_ordering::equal; // оба поля равны
    }
};
```
